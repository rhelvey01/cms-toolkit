flowchart TB
  subgraph ROOT["📦 cms-toolkit/ - the whole plugin: one folder, two halves"]
    direction TB

    subgraph PUB["📁 PUBLIC HALF - safe to share, goes to GitHub"]
      direction TB
      META["⚙️ .claude-plugin/plugin.json<br/>The name tag. Tells Claude this folder is a plugin."]
      DOCS["📝 README.md and FILES.md<br/>The front page and the map of every file."]
      IGN["🚫 .gitignore<br/>The bouncer. Keeps private stuff from being uploaded."]
      ADM["🗺️ admin/<br/>Pictures that explain how it all works."]
      EMP["📁 examples/ and tools/<br/>Empty drawers for later."]

      subgraph SK["📁 skills/ - the helpers"]
        direction TB
        subgraph DS["📁 cendyn-discovery - the detective"]
          D1["🧠 SKILL.md<br/>The steps the detective follows. Looks only, never touches."]
          D2["📁 references/defaults/<br/>What is normal on every Cendyn site, so we only note what is different."]
          D3["📁 references/templates/<br/>A blank form for a new kind of page."]
          D4["📁 references/examples/<br/>A finished pretend one to copy from."]
          D5["📜 probes.js and probe-sections.js<br/>Little tools you paste in the browser to peek at the admin."]
          D6["📐 page-type-profile.schema.json<br/>The rules a finished notes page must follow."]
        end
        subgraph CP["📁 cendyn-copy - the copier"]
          C1["🧠 SKILL.md<br/>Grabs the words from the old site and marks where each one came from."]
          C2["📐 content.schema.json and 🧩 example-rooms.content.json<br/>A blank form for the words, plus a pretend filled-in one."]
        end
        subgraph PB["📁 cendyn-page-builder - the builder"]
          B1["🧠 SKILL.md<br/>The only helper allowed to change the website. Builds pages, handles widgets and galleries, then writes it down."]
          B2["📜 build.js<br/>The hands that fill in the form and press Save."]
        end
        subgraph ML["📁 migration-log - the notebook keeper"]
          M1["🧠 SKILL.md<br/>Rules for the notebook: one line per page, always note problems."]
          M2["📁 templates/site-folder/<br/>A blank folder to start a new site, with a blank mapping.json."]
        end
      end
    end

    subgraph CJ["📁 PRIVATE HALF: content-jobs/ - real client work, stays on this computer"]
      direction TB
      TPL["📁 _template/<br/>A blank site folder to copy."]
      SUP["🗄️ _superseded/<br/>The attic. Old notes we replaced."]
      subgraph SITE["📁 site/ - one folder for each website"]
        direction TB
        S1["📝 instructions.md<br/>The rules for this site. Read it first."]
        S2["🧩 mapping.json<br/>One cheat sheet: what is odd about this site, how the old site maps over, and the list of building blocks."]
        S4["🧩 page-types/type.json<br/>The recipe for one kind of page, like rooms."]
        S5["📊 migration-log.csv<br/>The notebook. One line for every page we changed."]
        S6["📁 source-files/<br/>Old files and exports we were handed."]
      end
    end
  end

  subgraph LEG["Legend"]
    direction LR
    L1["📁 folder"]
    L2["🧠 instructions"]
    L3["📝 notes"]
    L4["🧩 data"]
    L5["📐 rules form"]
    L6["📜 script"]
    L7["📊 spreadsheet"]
    L8["🚫 ignore list"]
    L9["⚙️ name tag"]
    L10["🗺️ picture"]
  end

  style ROOT fill:#f3f3f3,stroke:#555,stroke-width:2px,color:#000
  style PUB fill:#eaf1fd,stroke:#2f6fdb,stroke-width:2px,color:#000
  style SK fill:#d3e2fa,stroke:#2f6fdb,color:#000
  style DS fill:#b4cdf5,stroke:#2f6fdb,color:#000
  style CP fill:#b4cdf5,stroke:#2f6fdb,color:#000
  style PB fill:#b4cdf5,stroke:#2f6fdb,color:#000
  style ML fill:#b4cdf5,stroke:#2f6fdb,color:#000
  style CJ fill:#fff3df,stroke:#e08a00,stroke-width:2px,color:#000
  style SITE fill:#ffdca8,stroke:#e08a00,color:#000
  style LEG fill:#fafafa,stroke:#999,color:#000

  classDef pub fill:#ffffff,stroke:#2f6fdb,color:#000
  classDef priv fill:#ffffff,stroke:#e08a00,color:#000
  classDef leg fill:#ffffff,stroke:#999,color:#000
  class META,DOCS,IGN,ADM,EMP,D1,D2,D3,D4,D5,D6,C1,C2,B1,B2,M1,M2 pub
  class TPL,SUP,S1,S2,S4,S5,S6 priv
  class L1,L2,L3,L4,L5,L6,L7,L8,L9,L10 leg
