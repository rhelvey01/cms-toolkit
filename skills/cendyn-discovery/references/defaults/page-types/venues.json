  "tabs": [
    "Copy",
    "Sections",
    "Layout",
    "Features/Amenities",
    "SEO/Meta",
    "Images",
    "Links",
    "Settings",
    "Attributes",
    "Versions",
    "Your Drafts"
  ],
  "tab_differences_from_rooms": "No Price tab (venues don't have pricing fields)",
  "assumptions": [
    "Layout section templates are shared with rooms; hashes differ per page",
    "Feature ids are venue-specific and do not overlap with room feature ids",
    "The brochure field is a document upload handled through the UI",
    "The form reuses the #edit-room id from the rooms module",
    "Layout sections and gallery images are optional per page"
  ],
  "_note": "Default Cendyn CMS reference (v.11.4), derived from a demo site and cross-checked against one production site. Copy this folder to content-jobs/<site>/ and verify per site. page_level_fields confirmed on a production site (all present except rooms type_id, which is optional per site). Feature ids and section hashes are per site."
}